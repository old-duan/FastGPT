# ==================== FastGPT MVP 环境配置 ====================
# 此文件用于 MVP 阶段，禁用所有企业级功能
# 使用方法：复制此文件为 .env.local
#   cp .env.local.mvp .env.local

# ==================== 特性开关（服务端）====================
# 发票系统（企业级功能）
ENABLE_INVOICE=false

# 组织架构（企业级功能）
ENABLE_ORG_STRUCTURE=false

# 群组管理（企业级功能）
ENABLE_GROUP_MANAGE=false

# 审计日志（企业级功能）
ENABLE_AUDIT_LOG=false

# SSO 单点登录（企业级功能）
ENABLE_SSO=false

# 自定义域名（企业级功能）
ENABLE_CUSTOM_DOMAIN=false

# 推广活动（营销功能）
ENABLE_PROMOTION=false

# 优惠券系统（营销功能）
ENABLE_COUPON=false

# OAuth 登录（微信、GitHub 等）
ENABLE_OAUTH_LOGIN=false

# 邀请链接系统（协作功能，可选启用）
ENABLE_INVITATION_LINK=false


# ==================== 特性开关（客户端，必须 NEXT_PUBLIC_ 前缀）====================
# 发票系统
NEXT_PUBLIC_ENABLE_INVOICE=false

# 组织架构
NEXT_PUBLIC_ENABLE_ORG_STRUCTURE=false

# 群组管理
NEXT_PUBLIC_ENABLE_GROUP_MANAGE=false

# 审计日志
NEXT_PUBLIC_ENABLE_AUDIT_LOG=false

# 自定义域名
NEXT_PUBLIC_ENABLE_CUSTOM_DOMAIN=false

# 推广活动
NEXT_PUBLIC_ENABLE_PROMOTION=false

# 优惠券系统
NEXT_PUBLIC_ENABLE_COUPON=false

# OAuth 登录
NEXT_PUBLIC_ENABLE_OAUTH_LOGIN=false

# 邀请链接系统
NEXT_PUBLIC_ENABLE_INVITATION_LINK=false


# ==================== 其他配置保持默认 ====================
# 参考项目根目录的 .env 文件配置其他必要的环境变量
# 例如数据库连接、API 密钥等
