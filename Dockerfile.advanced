# 多阶段构建 - 高级版 FastGPT
FROM node:20.14.0-alpine AS builder

WORKDIR /app

# 安装依赖
RUN npm install -g pnpm@9.1.0

# 复制所有源码
COPY . .

# 删除可能存在的 node_modules
RUN rm -rf node_modules packages/*/node_modules projects/*/node_modules

# 安装依赖
RUN pnpm install --frozen-lockfile

# 构建所有包
RUN pnpm -r --filter=./packages/* build && \
    pnpm -r --filter=@fastgpt/app build

# 生产镜像
FROM node:20.14.0-alpine

WORKDIR /app

# 安装必要的运行时依赖
RUN apk add --no-cache bash tzdata && \
    npm install -g pnpm@9.1.0

# 设置时区
ENV TZ=Asia/Shanghai

# 从 builder 复制构建产物
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/projects ./projects
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./

# 复制配置文件
COPY --from=builder /app/projects/app/data ./data

# 暴露端口
EXPOSE 3000

# 运行应用
CMD ["pnpm", "--filter=@fastgpt/app", "start"]
